# InfluxDB 2 connection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=default
INFLUXDB_BUCKET=weather

# InfluxDB schema
INFLUXDB_MEASUREMENT=drw
SPEED_FIELD=windspeed
DIRECTION_FIELD=direction
STATION_TAG=station

# Stations (comma-separated)
STATIONS=NorthLaunch,SouthLaunch,TigerLZ

# Stations where speed==0 & direction==360 readings are sensor "no-data"
# sentinels and should be excluded from windrose buckets and charts.
CALM_SENTINEL_STATIONS=TigerLZ

# Wind speed multiplier applied server-side to raw values.
# The DRW source reports mph, so this is 1.0 (no conversion).
# Use 2.236936 if your source is m/s, or 0.621371 for km/h.
# NOTE: read when the container is CREATED. After editing this,
# run `docker compose up -d` to recreate it — a restart won't
# pick up the new value.
SPEED_MULTIPLIER=1.0

# Ideal wind directions per station, used for direction-based dot colors.
# Each direction is four numbers: center center-width ccw-width cw-width
#   center        bearing the wind is best from
#   center-width  half-width of the deep-green core (+/- this many degrees)
#   ccw-width     degrees from the green edge, counter-clockwise, until red
#   cw-width      degrees from the green edge, clockwise, until red
# Multiple centers per station joined with '+', stations separated by ','.
# STATION_IDEAL_DIRS=NorthLaunch: 337.5 22.5 45 22.5, SouthLaunch: 200 20 25 25, TigerLZ: 0 20 20 20 + 180 20 20 20

# Site elevation in feet (for future cloudbase calculations)
# SITE_ELEVATION_FT=2021

# Windrose display settings
SPEED_BUCKET_COUNT=6
SPEED_BUCKET_SIZE=4
PETALS_PER_90DEG=4

# Optional extra fields (leave empty or unset to disable)
# HUMIDITY_FIELD=humidity
# TEMPERATURE_FIELD=temperature

# Display units
# SPEED_UNIT=mph
# TEMPERATURE_UNIT=°F
# HUMIDITY_UNIT=%

# App
TITLE=Wind Rose
PORT=80

# Static assets directory (default: "static")
# STATIC_DIR=static

# Logging (optional)
RUST_LOG=windrose_rs=info
